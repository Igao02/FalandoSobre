@page "/account-edit"
@inherits EditProfilePage
@rendermode InteractiveServer

<MudPopoverProvider />

<PageTitle>Perfil</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Perfil</MudText>

<form @onsubmit="OnSendEmailVerificationAsync" @formname="send-verification" id="send-verification-form" method="post">
    <AntiforgeryToken />
</form>
<EditForm Model="@Model" OnValidSubmit="OnValidSubmitAsync" FormName="profile">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem md="12">
            <MudTextField @bind-Value="Model.UserName"
                          For="@(() => Model.UserName)"
                          Label="Apelido do Usuário" 
                          HelperText="Alterar Apelido"/>
        </MudItem>
        <MudItem md="12">
            <MudTextField @bind-Value="Model.PhoneNumber"
                          For="@(() => Model.PhoneNumber)"
                          Label="Número de telefone"
                          HelperText="Por favor, insira seu número de telefone." />
        </MudItem>
        <MudItem md="12">
            <MudTextField @bind-Value="@email"
                          For="@(() => Model.NewEmail)"
                          Label="Email"
                          HelperText="Por favor, insira seu email." />
        </MudItem>
        <MudItem md="12">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" ButtonType="ButtonType.Submit">
                Salvar
            </MudButton>
        </MudItem>
    </MudGrid>
</EditForm>

