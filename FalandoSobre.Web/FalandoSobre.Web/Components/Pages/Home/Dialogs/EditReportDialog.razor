@using MudBlazor
@using FalandoSobre.Domain.Entities

<MudPopoverProvider />

<MudPaper Class="pa-6 rounded-lg" Elevation="5">
    <div class="d-flex align-center mb-6">
        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Large" Color="Color.Primary" Class="mr-3" />
        <MudText Typo="Typo.h4" Class="font-weight-bold" Color="Color.Dark">
            Editar Publicação
        </MudText>
    </div>

    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-6">
        Atualize os dados da publicação. Todas as alterações serão salvas imediatamente.
    </MudAlert>

    <EditForm Model="@_editModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        
        <MudGrid Spacing="3" Justify="Justify.FlexStart">
            <!-- Nome da Publicação -->
            <MudItem xs="12" md="6">
                <MudCard Class="h-100" Elevation="1">
                    <MudCardContent>
                        <div class="d-flex align-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Title" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Nome da Publicação</MudText>
                        </div>
                        <MudTextField @bind-Value="_editModel.ReportName"
                                    Required="true"
                                    Margin="Margin.Dense"
                                    Variant="Variant.Outlined"
                                    FullWidth="true"
                                    Placeholder="Digite o nome da publicação"
                                    Adornment="Adornment.Start"
                                    AdornmentIcon="@Icons.Material.Filled.DriveFileRenameOutline"
                                    Class="mb-2" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Máximo de 100 caracteres • @_editModel.ReportName?.Length/100
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Tipo da Publicação -->
            <MudItem xs="12" md="6">
                <MudCard Class="h-100" Elevation="1">
                    <MudCardContent>
                        <div class="d-flex align-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Tipo da Publicação</MudText>
                        </div>
                        <MudSelect T="string"
                                   Label="Tipo da Publicação"
                                   @bind-Value="_editModel.TypeReport"
                                   Required="true"
                                   Margin="Margin.Dense"
                                   Variant="Variant.Outlined"
                                   Class="mb-2"
                                   Style="max-width: 100%;"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Tune"
                                   HelperText="Selecione o tipo de publicação">
                            @foreach (var tipo in tipos)
                            {
                                <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
                            }
                        </MudSelect>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Mesmo tipo definido na criação original
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Descrição -->
            <MudItem xs="12">
                <MudCard Class="h-100" Elevation="1">
                    <MudCardContent>
                        <div class="d-flex align-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Descrição</MudText>
                        </div>
                        <MudTextField @bind-Value="_editModel.ReportDescription"
                                    Required="true"
                                    Margin="Margin.Dense"
                                    Variant="Variant.Outlined"
                                    FullWidth="true"
                                    Lines="4"
                                    TextArea="true"
                                    Placeholder="Descreva o conteúdo da publicação..."
                                    Adornment="Adornment.Start"
                                    AdornmentIcon="@Icons.Material.Filled.ShortText"
                                    Class="mb-2" />
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Atualize o conteúdo da publicação
                            </MudText>
                            <MudText Typo="Typo.caption" Color="@(_editModel.ReportDescription?.Length > 450 ? Color.Error : Color.Secondary)">
                                @_editModel.ReportDescription?.Length/500 caracteres
                            </MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Informações de Metadados -->
            <MudItem xs="12">
                <MudExpansionPanels Class="mt-4">
                    <MudExpansionPanel Text="Informações Adicionais" Icon="@Icons.Material.Filled.Info">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudPaper Class="pa-3 rounded" Elevation="0" Style="background-color: var(--mud-palette-grey-lighten-5)">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-2" Color="Color.Primary" />
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Autor</MudText>
                                            <MudText Typo="Typo.body2" Class="font-weight-medium">@Report.UserName</MudText>
                                        </div>
                                    </div>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudPaper Class="pa-3 rounded" Elevation="0" Style="background-color: var(--mud-palette-grey-lighten-5)">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Class="mr-2" Color="Color.Primary" />
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Data de Criação</MudText>
                                            <MudText Typo="Typo.body2" Class="font-weight-medium">@Report.ReportsDate.ToString("dd/MM/yyyy")</MudText>
                                        </div>
                                    </div>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudPaper Class="pa-3 rounded" Elevation="0" Style="background-color: var(--mud-palette-grey-lighten-5)">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" 
                                                Class="mr-2" 
                                                Color="@(Report.Actived ? Color.Success : Color.Error)" />
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                                            <MudText Typo="Typo.body2" Class="font-weight-medium">
                                                @(Report.Actived ? "Ativo" : "Inativo")
                                            </MudText>
                                        </div>
                                    </div>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudItem>
        </MudGrid>

        <!-- Ações -->
        <div class="d-flex justify-end mt-8 pt-4 border-t">
            <MudButton Color="Color.Default"
                      Variant="Variant.Outlined"
                      OnClick="Cancel"
                      StartIcon="@Icons.Material.Filled.Close"
                      Class="mr-3">
                Cancelar
            </MudButton>
            <MudButton Color="Color.Primary"
                      Variant="Variant.Filled"
                      ButtonType="ButtonType.Submit"
                      StartIcon="@Icons.Material.Filled.Save"
                      EndIcon="@Icons.Material.Filled.ArrowForward"
                      Class="px-6"
                      Disabled="@(!IsFormValid())">
                <MudText Class="font-weight-bold">Salvar Alterações</MudText>
            </MudButton>
        </div>
    </EditForm>
</MudPaper>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Report Report { get; set; } = null!;

    private Report _editModel = new();
    private bool _isLoading = false;

    protected override void OnInitialized()
    {
        _editModel = new Report(
            Report.ReportName,
            Report.TypeReport,
            Report.ReportDescription,
            Report.ReportsDate,
            Report.UserName,
            Report.IsEvent,
            Report.Actived,
            Report.ApplicationUserId
        )
        {
            Id = Report.Id
        };
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task HandleValidSubmit()
    {
        _isLoading = true;
        StateHasChanged();
        
        // Simular um pequeno delay para feedback visual
        await Task.Delay(300);
        
        MudDialog.Close(DialogResult.Ok(_editModel));
        _isLoading = false;
    }

    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(_editModel.ReportName) &&
               !string.IsNullOrWhiteSpace(_editModel.TypeReport) &&
               !string.IsNullOrWhiteSpace(_editModel.ReportDescription);
    }

    private List<string> tipos = new()
    {
        "Racismo",
        "Discriminação Feminina",
        "Discriminação LGBT"
    };
}