@page "/"
@rendermode InteractiveServer
@inherits HomePage
@using MudBlazor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>Publicações</PageTitle>

@* <MudGrid Justify="Justify.FlexEnd">
	@if (!string.IsNullOrEmpty(successMessage))
	{
		<MudAlert Severity="Severity.Success">@successMessage</MudAlert>
	}
	@if (!string.IsNullOrEmpty(errorMessage))
	{
		<MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
	}
</MudGrid> *@


<MudContainer MaxWidth="MaxWidth.Large" Style="margin-top: 2rem; margin-bottom: 2rem;">
	<MudGrid Spacing="3" Justify="Justify.Center">
		<!-- Feed Principal -->
		<MudItem xs="12" lg="9">
			<MudStack Gap="2rem" Class="fade-in">
				@foreach (var report in Model)
				{
					<MudPaper Elevation="10" Class="card-hover"
							  Style="border-radius: 24px; background: rgba(255,255,255,0.98);">
						<!-- Cabeçalho da Publicação -->
						<div Style="padding: 1.5rem 1.5rem 0 1.5rem;">
							<MudGrid Spacing="2" AlignItems="AlignItems.Center">
								<MudItem xs="2" md="1" Style="display: flex; justify-content: center;">
									<MudAvatar Size="Size.Large" Class="profile-avatar pulse-animation"
											   Style="width: 64px; height: 64px;">
										<MudImage Src="@GetProfilePhoto(report.ApplicationUserId.ToString())"
												  Alt="Foto de Perfil"
												  Style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
									</MudAvatar>
								</MudItem>
								<MudItem xs="10" md="11">
									<MudStack Gap="6px">
										<div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
											<MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #333;">
												@report.UserName
											</MudText>
											@if (report.IsEvent == true)
											{
												<MudChip T="string"
														 Size="Size.Small"
														 Color="Color.Primary"
														 Variant="Variant.Filled"
														 Class="ml-2"
														 Style="font-size: 0.7rem;">
													<MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Class="mr-1" />
													Evento
												</MudChip>

											}
											<MudChip T="string"
													 Size="Size.Small"
													 Color="Color.Secondary"
													 Variant="Variant.Outlined"
													 Style="font-size: 0.7rem; margin-left: auto;">
												@report.TypeReport
											</MudChip>

										</div>

										<MudText Typo="Typo.h5" Style="font-weight: 800; color: #2D3748; margin: 4px 0;">
											@report.ReportName
										</MudText>

										<div style="display: flex; align-items: center; gap: 16px; color: #718096;">
											<MudText Typo="Typo.caption" Style="display: flex; align-items: center; gap: 4px;">
												<MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
												@report.ReportsDate.ToString("dd MMM yyyy - HH:mm")
											</MudText>
											<MudText Typo="Typo.caption" Style="display: flex; align-items: center; gap: 4px;">
												<MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Small" />
												Público
											</MudText>
										</div>
									</MudStack>
								</MudItem>
							</MudGrid>
						</div>

						<!-- Conteúdo da Publicação -->
						<div Style="padding: 1rem 1.5rem;">
							<MudText Typo="Typo.body1" Style="line-height: 1.6; color: #444; margin-bottom: 1rem;">
								@report.ReportDescription
							</MudText>

							@if (report.Images != null && report.Images.Any())
							{
								var imageCount = report.Images.Count;
								<div class="@($"image-gallery {(imageCount == 1 ? "single-image" : imageCount == 2 ? "two-images" : imageCount == 3 ? "three-images" : "four-images")}")">
									@foreach (var image in report.Images)
									{
										<MudImage Src="@image.ImageUrl"
												  Class="post-image"
												  Style="width: 100%; height: 100%;
												                                                                        max-height: 400px;
												                                                                        object-fit: cover;
												                                                                        cursor: pointer;
												                                                                        transition: transform 0.3s ease;
												                                                                        &:hover {
												                                                                            transform: scale(1.02);
												                                                                        }" />
									}
								</div>
							}
							else
							{
								<MudPaper Elevation="0"
										  Style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
								                                                            border-radius: 16px;
								                                                            height: 150px;
								                                                            display: flex;
								                                                            align-items: center;
								                                                            justify-content: center;
								                                                            margin-top: 1rem;">
									<MudStack AlignItems="AlignItems.Center" Gap="8px">
										<MudIcon Icon="@Icons.Material.Filled.PhotoCamera"
												 Size="Size.Large"
												 Style="color: #5D5FEF; opacity: 0.5;" />
										<MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-style: italic;">
											Nenhuma imagem disponível
										</MudText>
									</MudStack>
								</MudPaper>
							}
						</div>

						<!-- Estatísticas -->
						<div Style="padding: 0 1.5rem;">
							<MudGrid Spacing="2">
								<MudItem xs="4">
									<MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 600;">
										<MudIcon Icon="@Icons.Material.Filled.ThumbUp" Size="Size.Small" />
										@GetLikeCount(report.Id) Curtidas
									</MudText>
								</MudItem>
								<MudItem xs="4">
									<MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600;">
										<MudIcon Icon="@Icons.Material.Filled.Comment" Size="Size.Small" />
										@(CommentAppService.Comments.TryGetValue(report.Id, out var comments)
																			? comments.Count : 0) Comentários
									</MudText>
								</MudItem>
								<MudItem xs="4">
									<MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600;">
										<MudIcon Icon="@Icons.Material.Filled.Share" Size="Size.Small" />
										0 Compartilhamentos
									</MudText>
								</MudItem>
							</MudGrid>
						</div>

						<!-- Ações -->
						<MudCardActions Style="padding: 1rem 1.5rem; border-top: 1px solid rgba(0,0,0,0.05);">
							<MudButton Variant="Variant.Text"
									   Color="@(HasUserLiked(report.Id) ? Color.Primary : Color.Default)"
									   Class="@(HasUserLiked(report.Id) ? "like-button active" : "like-button")"
									   StartIcon="@Icons.Material.Filled.ThumbUp"
									   Size="Size.Small"
									   OnClick="@(() => ToggleLikeAsync(report.Id))"
									   Style="border-radius: 8px; text-transform: none; font-weight: 500;">
								@(HasUserLiked(report.Id) ? "Curtido" : "Curtir")
							</MudButton>

							<MudButton Variant="Variant.Text"
									   Color="Color.Default"
									   StartIcon="@Icons.Material.Filled.Comment"
									   Size="Size.Small"
									   Style="border-radius: 8px; text-transform: none; font-weight: 500;"
									   OnClick="@(() => ToggleComments(report.Id))">
								Comentar
							</MudButton>

							<MudButton Variant="Variant.Text"
									   Color="Color.Default"
									   StartIcon="@Icons.Material.Filled.Share"
									   Size="Size.Small"
									   Style="border-radius: 8px; text-transform: none; font-weight: 500;">
								Compartilhar
							</MudButton>

							<div style="flex-grow: 1;"></div>

							@if (!string.IsNullOrEmpty(CurrentUserId) && report.ApplicationUserId == CurrentUserId)
							{
								<MudButton Variant="Variant.Text"
										   Color="Color.Primary"
										   StartIcon="@Icons.Material.Filled.Edit"
										   Size="Size.Small"
										   Style="border-radius: 8px; text-transform: none; font-weight: 500; margin-right: 4px;"
										   OnClick="@(() => OpenEditReportDialogAsync(report))">
									Editar
								</MudButton>

								<MudButton Variant="Variant.Text"
										   Color="Color.Error"
										   StartIcon="@Icons.Material.Filled.Delete"
										   Size="Size.Small"
										   Style="border-radius: 8px; text-transform: none; font-weight: 500;"
										   OnClick="@(() => DeleteReportAsync(report.Id))">
									Excluir
								</MudButton>
							}

							<MudButton Variant="Variant.Text"
									   Color="Color.Default"
									   StartIcon="@Icons.Material.Filled.Bookmark"
									   Size="Size.Small"
									   Style="border-radius: 8px; text-transform: none;">
								Salvar
							</MudButton>
						</MudCardActions>

						<!-- Seção de Comentários -->
						@if (CommentAppService.IsOpen(report.Id))
						{
							<div class="comment-section" Style="padding: 1.5rem;">
								<MudText Typo="Typo.subtitle2" Style="font-weight: 600; margin-bottom: 1rem; color: #333;">
									<MudIcon Icon="@Icons.Material.Filled.Comment" Size="Size.Small" Style="margin-right: 8px;" />
									Comentários
								</MudText>

								@if (CommentAppService.Comments.TryGetValue(report.Id, out var comments) && comments.Any())
								{
									<MudStack Gap="1rem">
										@foreach (var comment in comments)
										{
											<MudPaper Elevation="1" Style="padding: 1rem; border-radius: 12px; background: white;">
												<MudGrid Spacing="2" AlignItems="AlignItems.Center">
													<MudItem xs="12" Style="display: flex; align-items: center; gap: 8px;">
														<MudAvatar Size="Size.Small" Style="width: 32px; height: 32px;">
															<MudImage Src="@GetProfilePhoto(comment.ApplicationUserId!)"
																	  Alt="Foto de Perfil"
																	  Style="width: 100%; height: 100%; object-fit: cover;" />
														</MudAvatar>
														<div style="flex-grow: 1;">
															<MudText Typo="Typo.body2" Style="font-weight: 600; color: #333;">
																@comment.UserName
															</MudText>
															<MudText Typo="Typo.caption" Color="Color.Secondary">
																@comment.CommentDate.ToString("dd/MM/yyyy HH:mm")
															</MudText>
														</div>
														@if (!string.IsNullOrEmpty(CurrentUserId) && comment.ApplicationUserId == CurrentUserId)
														{
															<MudIconButton Icon="@Icons.Material.Filled.Delete"
																		   Color="Color.Error"
																		   Size="Size.Small"
																		   OnClick="@(() => DeleteCommentAsync(report.Id, comment.Id))" />
														}
													</MudItem>
													<MudItem xs="12">
														<MudText Typo="Typo.body2" Style="color: #444;">
															@comment.CommentContent
														</MudText>
													</MudItem>
												</MudGrid>
											</MudPaper>
										}
									</MudStack>
								}
								else
								{
									<MudPaper Elevation="0"
											  Style="padding: 2rem; text-align: center; background: transparent;">
										<MudIcon Icon="@Icons.Material.Filled.Forum"
												 Size="Size.Large"
												 Style="color: #ccc; margin-bottom: 1rem;" />
										<MudText Typo="Typo.body2" Color="Color.Secondary">
											Seja o primeiro a comentar!
										</MudText>
									</MudPaper>
								}

								<!-- Novo Comentário -->
								<MudPaper Elevation="1" Style="padding: 1rem; border-radius: 12px; margin-top: 1.5rem; background: white;">
									<MudStack Gap="1rem">
										<MudTextField T="string"
													  Value="CommentAppService.GetDraft(report.Id)"
													  ValueChanged="@(v => CommentAppService.SetDraft(report.Id, v))"
													  Placeholder="Escreva um comentário..."
													  Lines="3"
													  FullWidth="true"
													  Immediate="true"
													  Variant="Variant.Outlined" />

										<div style="display: flex; justify-content: flex-end; gap: 8px;">
											<MudButton Variant="Variant.Outlined"
													   Color="Color.Secondary"
													   Size="Size.Small"
													   OnClick="@(() => CommentAppService.ClearDraft(report.Id))">
												Limpar
											</MudButton>
											<MudButton Variant="Variant.Filled"
													   Color="Color.Primary"
													   EndIcon="@Icons.Material.Filled.Send"
													   Size="Size.Small"
													   OnClick="@(() => AddCommentAsync(report.Id))"
													   Style="border-radius: 8px;">
												Enviar Comentário
											</MudButton>
										</div>
									</MudStack>
								</MudPaper>
							</div>
						}
					</MudPaper>
				}
			</MudStack>

			<!-- Paginação -->
			<MudPaper Elevation="0" Style="background-color: transparent; padding: 2rem 0;">
				<div style="display: flex; justify-content: center;">
					<MudPagination Color="Color.Primary"
								   SelectedChanged="OnPageChanged"
								   Count="TotalPages"
								   Size="Size.Small"
								   Style="border-radius: 12px; overflow: hidden;" />
				</div>
			</MudPaper>
		</MudItem>
	</MudGrid>
</MudContainer>