@page "/"
@rendermode InteractiveServer
@inherits HomePage
@using MudBlazor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>Publicações</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Style="margin-top: 2rem; margin-bottom: 2rem;">
    <MudGrid Spacing="3" Justify="Justify.Center">
        <!-- Feed Principal -->
        <MudItem xs="12" lg="8">
            <MudStack Gap="2rem" Class="fade-in">
                @foreach (var item in Feed)
                {
                    @if (item.IsShared)
                    {
                        <!-- DESIGN ALTERNATIVO PARA PUBLICAÇÕES COMPARTILHADAS -->
                        <MudPaper Elevation="8" Class="card-hover"
                                  Style="border-radius: 24px; background: linear-gradient(135deg, #FFFFFF 0%, #F8FAFF 100%); border-left: 5px solid #5D5FEF; position: relative;">
                            <!-- Indicador de Compartilhamento -->
                            <div style="position: absolute; top: 12px; right: 12px;">
                                <MudChip T="string"
                                         Color="Color.Primary"
                                         Variant="Variant.Filled"
                                         Size="Size.Small"
                                         Style="background: #5D5FEF; color: white; font-size: 0.7rem;">
                                    <MudIcon Icon="@Icons.Material.Filled.Share" Size="Size.Small" Class="mr-1" />
                                    Compartilhado
                                </MudChip>
                            </div>

                            <!-- Cabeçalho com Informação de Compartilhamento -->
                            <div style="padding: 1.5rem 1.5rem 0.75rem 1.5rem; background: linear-gradient(90deg, rgba(93, 95, 239, 0.08) 0%, rgba(255, 255, 255, 0) 100%);">
                                <MudStack Gap="0.5rem">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <MudAvatar Size="Size.Small" Style="width: 32px; height: 32px;">
                                            <MudImage Src="@GetProfilePhoto(item.SharedByUserId ?? "")"
                                                      Alt="Foto de Perfil"
                                                      Style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                                        </MudAvatar>
                                        <div>
                                            <MudText Typo="Typo.body2" Style="font-weight: 600; color: #5D5FEF;">
                                                <MudIcon Icon="@Icons.Material.Filled.Share" Size="Size.Small" Class="mr-1" />
                                                @item.SharedByUserName compartilhou
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @item.EventDate.ToString("dd MMM yyyy - HH:mm")
                                            </MudText>
                                        </div>
                                    </div>
                                </MudStack>
                            </div>

                            <!-- Card Interno para a Publicação Original -->
                            <MudPaper Elevation="0"
                                      Style="margin: 1rem; border-radius: 16px; background: white; border: 1px solid rgba(0,0,0,0.1);">
                                <!-- Cabeçalho da Publicação Original -->
                                <div Style="padding: 1.5rem 1.5rem 0 1.5rem;">
                                    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                        <MudItem xs="2" md="1" Style="display: flex; justify-content: center;">
                                            <MudAvatar Size="Size.Large" Class="profile-avatar"
                                                       Style="width: 56px; height: 56px; border: 2px solid #F0F2F5;">
                                                <MudImage Src="@GetProfilePhoto(item.Report.ApplicationUserId.ToString())"
                                                          Alt="Foto de Perfil"
                                                          Style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                                            </MudAvatar>
                                        </MudItem>
                                        <MudItem xs="12" md="10">
                                            <MudStack Gap="6px">
                                                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #333;">
                                                        @item.Report.UserName
                                                    </MudText>
                                                    @if (item.Report.IsEvent == true)
                                                    {
                                                        <MudChip T="string"
                                                                 Size="Size.Small"
                                                                 Color="Color.Primary"
                                                                 Variant="Variant.Filled"
                                                                 Class="ml-2"
                                                                 Style="font-size: 0.7rem;">
                                                            <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Class="mr-1" />
                                                            Evento
                                                        </MudChip>
                                                    }
                                                    <MudChip T="string"
                                                             Size="Size.Small"
                                                             Color="Color.Secondary"
                                                             Variant="Variant.Outlined"
                                                             Style="font-size: 0.7rem; margin-left: auto;">
                                                        @item.Report.TypeReport
                                                    </MudChip>
                                                </div>

                                                <MudText Typo="Typo.h5" Style="font-weight: 800; color: #2D3748; margin: 4px 0;">
                                                    @item.Report.ReportName
                                                </MudText>

                                                <div style="display: flex; align-items: center; gap: 16px; color: #718096;">
                                                    <MudText Typo="Typo.caption" Style="display: flex; align-items: center; gap: 4px;">
                                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                                        @item.Report.ReportsDate.ToString("dd MMM yyyy - HH:mm")
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Style="display: flex; align-items: center; gap: 4px;">
                                                        <MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Small" />
                                                        Público
                                                    </MudText>
                                                </div>
                                            </MudStack>
                                        </MudItem>
                                    </MudGrid>
                                </div>

                                <!-- Conteúdo da Publicação Original -->
                                <div Style="padding: 1rem 1.5rem;">
                                    <MudText Typo="Typo.body1" Style="line-height: 1.6; color: #444; margin-bottom: 1rem;">
                                        @item.Report.ReportDescription
                                    </MudText>

                                    @if (item.Report.Images != null && item.Report.Images.Any())
                                    {
                                        var imageCount = item.Report.Images.Count;
                                        <div class="@($"image-gallery {(imageCount == 1 ? "single-image" : imageCount == 2 ? "two-images" : imageCount == 3 ? "three-images" : "four-images")}")">
                                            @foreach (var image in item.Report.Images)
                                            {
                                                <MudImage Src="@image.ImageUrl"
                                                          Class="post-image"
                                                          Style="width: 100%; height: 100%; max-height: 400px;
                                                                                object-fit: cover;cursor: pointer;transition:
                                                                                transform 0.3s ease;&:hover {transform: scale(1.02);}" />
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <MudPaper Elevation="0"
                                                  Style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); border-radius: 16px; height: 150px;
                                                                    display: flex; align-items: center; justify-content: center;margin-top: 1rem;">

                                            <MudStack AlignItems="AlignItems.Center" Gap="8px">
                                                <MudIcon Icon="@Icons.Material.Filled.PhotoCamera"
                                                         Size="Size.Large"
                                                         Style="color: #5D5FEF; opacity: 0.5;" />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-style: italic;">
                                                    Nenhuma imagem disponível
                                                </MudText>
                                            </MudStack>
                                        </MudPaper>
                                    }
                                </div>

                                <!-- Estatísticas da Publicação Original -->
                                <div Style="padding: 0 1.5rem;">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="4">
                                            <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 600;">
                                                <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Size="Size.Small" />
                                                @GetLikeCount(item.Report.Id) Curtidas
                                            </MudText>
                                        </MudItem>
                                        <MudItem xs="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600;">
                                                <MudIcon Icon="@Icons.Material.Filled.Comment" Size="Size.Small" />
                                                @(CommentAppService.Comments.TryGetValue(item.Report.Id, out var comments)
                                                                                        ? comments.Count : 0) Comentários
                                            </MudText>
                                        </MudItem>
                                        <MudItem xs="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600;">
                                                <MudIcon Icon="@Icons.Material.Filled.Share" Size="Size.Small" />
                                                @GetShareCount(item.Report.Id) Compartilhamentos
                                            </MudText>
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            </MudPaper>

                            <!-- Ações Específicas para Compartilhamento -->
                            <MudCardActions Style="padding: 1rem 1.5rem; border-top: 1px solid rgba(0,0,0,0.05); background: #F8FAFF;">
                                <MudButton Variant="Variant.Text"
                                           Color="@(HasUserLiked(item.Report.Id) ? Color.Primary : Color.Default)"
                                           Class="@(HasUserLiked(item.Report.Id) ? "like-button active" : "like-button")"
                                           StartIcon="@Icons.Material.Filled.ThumbUp"
                                           Size="Size.Small"
                                           OnClick="@(() => ToggleLikeAsync(item.Report.Id))"
                                           Style="border-radius: 8px; text-transform: none; font-weight: 500;">
                                    @(HasUserLiked(item.Report.Id) ? "Curtido" : "Curtir")
                                </MudButton>

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Default"
                                           StartIcon="@Icons.Material.Filled.Comment"
                                           Size="Size.Small"
                                           Style="border-radius: 8px; text-transform: none; font-weight: 500;"
                                           OnClick="@(() => ToggleComments(item.Report.Id))">
                                    Comentar
                                </MudButton>

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Share"
                                           Size="Size.Small"
                                           Style="border-radius: 8px; text-transform: none; font-weight: 500;"
                                           OnClick="@(() => CreateSharedReports(item.Report.Id))">
                                    Compartilhar
                                </MudButton>

                                <div style="flex-grow: 1;"></div>

                                @if (!string.IsNullOrEmpty(CurrentUserId) && item.Report.ApplicationUserId == CurrentUserId)
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Style="border-radius: 8px; text-transform: none; font-weight: 500; margin-right: 4px;"
                                               OnClick="@(() => OpenEditReportDialogAsync(item.Report))">
                                        Editar
                                    </MudButton>

                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Style="border-radius: 8px; text-transform: none; font-weight: 500;"
                                               OnClick="@(() => DeleteReportAsync(item.Report.Id))">
                                        Excluir
                                    </MudButton>
                                }

                                @if (item.SharedByUserId == CurrentUserId)
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Style="border-radius: 8px; text-transform: none; font-weight: 500;"
                                               OnClick="@(() => RemoveSharedReportAsync(item.EventId))">
                                        Remover Compartilhamento
                                    </MudButton>
                                }

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Default"
                                           StartIcon="@Icons.Material.Filled.Bookmark"
                                           Size="Size.Small"
                                           Style="border-radius: 8px; text-transform: none;">
                                    Salvar
                                </MudButton>
                            </MudCardActions>

                            <!-- Seção de Comentários -->
                            @if (CommentAppService.IsOpen(item.Report.Id))
                            {
                                <div class="comment-section" Style="padding: 1.5rem;">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600; margin-bottom: 1rem; color: #333;">
                                        <MudIcon Icon="@Icons.Material.Filled.Comment" Size="Size.Small" Style="margin-right: 8px;" />
                                        Comentários
                                    </MudText>

                                    @if (CommentAppService.Comments.TryGetValue(item.Report.Id, out var comments) && comments.Any())
                                    {
                                        <MudStack Gap="1rem">
                                            @foreach (var comment in comments)
                                            {
                                                <MudPaper Elevation="1" Style="padding: 1rem; border-radius: 12px; background: white;">
                                                    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                                        <MudItem xs="12" Style="display: flex; align-items: center; gap: 8px;">
                                                            <MudAvatar Size="Size.Small" Style="width: 32px; height: 32px;">
                                                                <MudImage Src="@GetProfilePhoto(comment.ApplicationUserId!)"
                                                                          Alt="Foto de Perfil"
                                                                          Style="width: 100%; height: 100%; object-fit: cover;" />
                                                            </MudAvatar>
                                                            <div style="flex-grow: 1;">
                                                                <MudText Typo="Typo.body2" Style="font-weight: 600; color: #333;">
                                                                    @comment.UserName
                                                                </MudText>
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                    @comment.CommentDate.ToString("dd/MM/yyyy HH:mm")
                                                                </MudText>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(CurrentUserId) && comment.ApplicationUserId == CurrentUserId)
                                                            {
                                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                               Color="Color.Error"
                                                                               Size="Size.Small"
                                                                               OnClick="@(() => DeleteCommentAsync(item.Report.Id, comment.Id))" />
                                                            }
                                                        </MudItem>
                                                        <MudItem xs="12">
                                                            <MudText Typo="Typo.body2" Style="color: #444;">
                                                                @comment.CommentContent
                                                            </MudText>
                                                        </MudItem>
                                                    </MudGrid>
                                                </MudPaper>
                                            }
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudPaper Elevation="0"
                                                  Style="padding: 2rem; text-align: center; background: transparent;">
                                            <MudIcon Icon="@Icons.Material.Filled.Forum"
                                                     Size="Size.Large"
                                                     Style="color: #ccc; margin-bottom: 1rem;" />
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                Seja o primeiro a comentar!
                                            </MudText>
                                        </MudPaper>
                                    }

                                    <!-- Novo Comentário -->
                                    <MudPaper Elevation="1" Style="padding: 1rem; border-radius: 12px; margin-top: 1.5rem; background: white;">
                                        <MudStack Gap="1rem">
                                            <MudTextField T="string"
                                                          Value="CommentAppService.GetDraft(item.Report.Id)"
                                                          ValueChanged="@(v => CommentAppService.SetDraft(item.Report.Id, v))"
                                                          Placeholder="Escreva um comentário..."
                                                          Lines="3"
                                                          FullWidth="true"
                                                          Immediate="true"
                                                          Variant="Variant.Outlined" />

                                            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                                                <MudButton Variant="Variant.Outlined"
                                                           Color="Color.Secondary"
                                                           Size="Size.Small"
                                                           OnClick="@(() => CommentAppService.ClearDraft(item.Report.Id))">
                                                    Limpar
                                                </MudButton>
                                                <MudButton Variant="Variant.Filled"
                                                           Color="Color.Primary"
                                                           EndIcon="@Icons.Material.Filled.Send"
                                                           Size="Size.Small"
                                                           OnClick="@(() => AddCommentAsync(item.Report.Id))"
                                                           Style="border-radius: 8px;">
                                                    Enviar Comentário
                                                </MudButton>
                                            </div>
                                        </MudStack>
                                    </MudPaper>
                                </div>
                            }
                        </MudPaper>
                    }
                    else
                    {
                        <!-- DESIGN ORIGINAL PARA PUBLICAÇÕES NÃO COMPARTILHADAS -->
                        <MudPaper Elevation="10" Class="card-hover"
                                  Style="border-radius: 24px; background: rgba(255,255,255,0.98);">
                            @if (item.IsShared)
                            {
                                <div style="padding: 0.75rem 1.5rem; background: #F7FAFC; border-radius: 24px 24px 0 0;">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                                             Style="display: flex; align-items: center; gap: 6px;">
                                        <MudIcon Icon="@Icons.Material.Filled.Repeat" Size="Size.Small" />
                                        Compartilhado por <strong>@item.SharedByUserName</strong>
                                    </MudText>
                                </div>
                            }
                            <!-- Cabeçalho da Publicação -->
                            <div Style="padding: 1.5rem 1.5rem 0 1.5rem;">
                                <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                    <MudItem xs="2" md="1" Style="display: flex; justify-content: center;">
                                        <MudAvatar Size="Size.Large" Class="profile-avatar pulse-animation"
                                                   Style="width: 64px; height: 64px;">
                                            <MudImage Src="@GetProfilePhoto(item.Report.ApplicationUserId.ToString())"
                                                      Alt="Foto de Perfil"
                                                      Style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                                        </MudAvatar>
                                    </MudItem>
                                    <MudItem xs="12" md="10">
                                        <MudStack Gap="6px">
                                            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #333;">
                                                    @item.Report.UserName
                                                </MudText>
                                                @if (item.Report.IsEvent == true)
                                                {
                                                    <MudChip T="string"
                                                             Size="Size.Small"
                                                             Color="Color.Primary"
                                                             Variant="Variant.Filled"
                                                             Class="ml-2"
                                                             Style="font-size: 0.7rem;">
                                                        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Class="mr-1" />
                                                        Evento
                                                    </MudChip>

                                                }
                                                <MudChip T="string"
                                                         Size="Size.Small"
                                                         Color="Color.Secondary"
                                                         Variant="Variant.Outlined"
                                                         Style="font-size: 0.7rem; margin-left: auto;">
                                                    @item.Report.TypeReport
                                                </MudChip>
                                            </div>

                                            <MudText Typo="Typo.h5" Style="font-weight: 800; color: #2D3748; margin: 4px 0;">
                                                @item.Report.ReportName
                                            </MudText>

                                            <div style="display: flex; align-items: center; gap: 16px; color: #718096;">
                                                <MudText Typo="Typo.caption" Style="display: flex; align-items: center; gap: 4px;">
                                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                                    @item.Report.ReportsDate.ToString("dd MMM yyyy - HH:mm")
                                                </MudText>
                                                <MudText Typo="Typo.caption" Style="display: flex; align-items: center; gap: 4px;">
                                                    <MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Small" />
                                                    Público
                                                </MudText>
                                            </div>
                                        </MudStack>
                                    </MudItem>
                                </MudGrid>
                            </div>

                            <!-- Conteúdo da Publicação -->
                            <div Style="padding: 1rem 1.5rem;">
                                <MudText Typo="Typo.body1" Style="line-height: 1.6; color: #444; margin-bottom: 1rem;">
                                    @item.Report.ReportDescription
                                </MudText>

                                @if (item.Report.Images != null && item.Report.Images.Any())
                                {
                                    var imageCount = item.Report.Images.Count;
                                    <div class="@($"image-gallery {(imageCount == 1 ? "single-image" : imageCount == 2 ? "two-images" : imageCount == 3 ? "three-images" : "four-images")}")">
                                        @foreach (var image in item.Report.Images)
                                        {
                                            <MudImage Src="@image.ImageUrl"
                                                      Class="post-image"
                                                      Style="width: 100%; height: 100%; max-height: 400px;
                                                                            object-fit: cover;cursor: pointer;transition:
                                                                            transform 0.3s ease;&:hover {transform: scale(1.02);}" />
                                        }
                                    </div>
                                }
                                else
                                {
                                    <MudPaper Elevation="0"
                                              Style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); border-radius: 16px; height: 150px;
                                                                display: flex; align-items: center; justify-content: center;margin-top: 1rem;">

                                        <MudStack AlignItems="AlignItems.Center" Gap="8px">
                                            <MudIcon Icon="@Icons.Material.Filled.PhotoCamera"
                                                     Size="Size.Large"
                                                     Style="color: #5D5FEF; opacity: 0.5;" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-style: italic;">
                                                Nenhuma imagem disponível
                                            </MudText>
                                        </MudStack>
                                    </MudPaper>
                                }
                            </div>

                            <!-- Estatísticas -->
                            <div Style="padding: 0 1.5rem;">
                                <MudGrid Spacing="2">
                                    <MudItem xs="4">
                                        <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 600;">
                                            <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Size="Size.Small" />
                                            @GetLikeCount(item.Report.Id) Curtidas
                                        </MudText>
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600;">
                                            <MudIcon Icon="@Icons.Material.Filled.Comment" Size="Size.Small" />
                                            @(CommentAppService.Comments.TryGetValue(item.Report.Id, out var comments)
                                                                                ? comments.Count : 0) Comentários
                                        </MudText>
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600;">
                                            <MudIcon Icon="@Icons.Material.Filled.Share" Size="Size.Small" />
                                            @GetShareCount(item.Report.Id) Compartilhamentos
                                        </MudText>
                                    </MudItem>
                                </MudGrid>
                            </div>

                            <!-- Ações -->
                            <MudCardActions Style="padding: 1rem 1.5rem; border-top: 1px solid rgba(0,0,0,0.05);">
                                <MudButton Variant="Variant.Text"
                                           Color="@(HasUserLiked(item.Report.Id) ? Color.Primary : Color.Default)"
                                           Class="@(HasUserLiked(item.Report.Id) ? "like-button active" : "like-button")"
                                           StartIcon="@Icons.Material.Filled.ThumbUp"
                                           Size="Size.Small"
                                           OnClick="@(() => ToggleLikeAsync(item.Report.Id))"
                                           Style="border-radius: 8px; text-transform: none; font-weight: 500;">
                                    @(HasUserLiked(item.Report.Id) ? "Curtido" : "Curtir")
                                </MudButton>

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Default"
                                           StartIcon="@Icons.Material.Filled.Comment"
                                           Size="Size.Small"
                                           Style="border-radius: 8px; text-transform: none; font-weight: 500;"
                                           OnClick="@(() => ToggleComments(item.Report.Id))">
                                    Comentar
                                </MudButton>

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Default"
                                           StartIcon="@Icons.Material.Filled.Share"
                                           Size="Size.Small"
                                           Style="border-radius: 8px; text-transform: none; font-weight: 500;"
                                           OnClick="@(() => CreateSharedReports(item.Report.Id))">
                                    Compartilhar
                                </MudButton>

                                <div style="flex-grow: 1;"></div>

                                @if (!string.IsNullOrEmpty(CurrentUserId) && item.Report.ApplicationUserId == CurrentUserId)
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Style="border-radius: 8px; text-transform: none; font-weight: 500; margin-right: 4px;"
                                               OnClick="@(() => OpenEditReportDialogAsync(item.Report))">
                                        Editar
                                    </MudButton>

                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Style="border-radius: 8px; text-transform: none; font-weight: 500;"
                                               OnClick="@(() => DeleteReportAsync(item.Report.Id))">
                                        Excluir
                                    </MudButton>
                                }

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Default"
                                           StartIcon="@Icons.Material.Filled.Bookmark"
                                           Size="Size.Small"
                                           Style="border-radius: 8px; text-transform: none;">
                                    Salvar
                                </MudButton>
                            </MudCardActions>

                            <!-- Seção de Comentários -->
                            @if (CommentAppService.IsOpen(item.Report.Id))
                            {
                                <div class="comment-section" Style="padding: 1.5rem;">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600; margin-bottom: 1rem; color: #333;">
                                        <MudIcon Icon="@Icons.Material.Filled.Comment" Size="Size.Small" Style="margin-right: 8px;" />
                                        Comentários
                                    </MudText>

                                    @if (CommentAppService.Comments.TryGetValue(item.Report.Id, out var comments) && comments.Any())
                                    {
                                        <MudStack Gap="1rem">
                                            @foreach (var comment in comments)
                                            {
                                                <MudPaper Elevation="1" Style="padding: 1rem; border-radius: 12px; background: white;">
                                                    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                                        <MudItem xs="12" Style="display: flex; align-items: center; gap: 8px;">
                                                            <MudAvatar Size="Size.Small" Style="width: 32px; height: 32px;">
                                                                <MudImage Src="@GetProfilePhoto(comment.ApplicationUserId!)"
                                                                          Alt="Foto de Perfil"
                                                                          Style="width: 100%; height: 100%; object-fit: cover;" />
                                                            </MudAvatar>
                                                            <div style="flex-grow: 1;">
                                                                <MudText Typo="Typo.body2" Style="font-weight: 600; color: #333;">
                                                                    @comment.UserName
                                                                </MudText>
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                    @comment.CommentDate.ToString("dd/MM/yyyy HH:mm")
                                                                </MudText>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(CurrentUserId) && comment.ApplicationUserId == CurrentUserId)
                                                            {
                                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                               Color="Color.Error"
                                                                               Size="Size.Small"
                                                                               OnClick="@(() => DeleteCommentAsync(item.Report.Id, comment.Id))" />
                                                            }
                                                        </MudItem>
                                                        <MudItem xs="12">
                                                            <MudText Typo="Typo.body2" Style="color: #444;">
                                                                @comment.CommentContent
                                                            </MudText>
                                                        </MudItem>
                                                    </MudGrid>
                                                </MudPaper>
                                            }
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudPaper Elevation="0"
                                                  Style="padding: 2rem; text-align: center; background: transparent;">
                                            <MudIcon Icon="@Icons.Material.Filled.Forum"
                                                     Size="Size.Large"
                                                     Style="color: #ccc; margin-bottom: 1rem;" />
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                Seja o primeiro a comentar!
                                            </MudText>
                                        </MudPaper>
                                    }

                                    <!-- Novo Comentário -->
                                    <MudPaper Elevation="1" Style="padding: 1rem; border-radius: 12px; margin-top: 1.5rem; background: white;">
                                        <MudStack Gap="1rem">
                                            <MudTextField T="string"
                                                          Value="CommentAppService.GetDraft(item.Report.Id)"
                                                          ValueChanged="@(v => CommentAppService.SetDraft(item.Report.Id, v))"
                                                          Placeholder="Escreva um comentário..."
                                                          Lines="3"
                                                          FullWidth="true"
                                                          Immediate="true"
                                                          Variant="Variant.Outlined" />

                                            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                                                <MudButton Variant="Variant.Outlined"
                                                           Color="Color.Secondary"
                                                           Size="Size.Small"
                                                           OnClick="@(() => CommentAppService.ClearDraft(item.Report.Id))">
                                                    Limpar
                                                </MudButton>
                                                <MudButton Variant="Variant.Filled"
                                                           Color="Color.Primary"
                                                           EndIcon="@Icons.Material.Filled.Send"
                                                           Size="Size.Small"
                                                           OnClick="@(() => AddCommentAsync(item.Report.Id))"
                                                           Style="border-radius: 8px;">
                                                    Enviar Comentário
                                                </MudButton>
                                            </div>
                                        </MudStack>
                                    </MudPaper>
                                </div>
                            }
                        </MudPaper>
                    }
                }
            </MudStack>

            <!-- Paginação -->
            <MudPaper Elevation="0" Style="background-color: transparent; padding: 2rem 0;">
                <div style="display: flex; justify-content: center;">
                    <MudPagination Color="Color.Primary"
                                   Selected="CurrentPage"
                                   SelectedChanged="OnPageChanged"
                                   Count="TotalPages"
                                   Size="Size.Small" />
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>